# ========================
# Xcode / Swift Project
# ========================

# Build products
build/
DerivedData/
*.o
*.LinkFileList
*.hmap

# User-specific Xcode settings
xcuserdata/
*.xcuserstate
*.xcscmblueprint

# SwiftPM
.swiftpm/
.build/
Package.resolved

# CocoaPods
Pods/
Podfile.lock

# Carthage
Carthage/Build/

# Tuist / SPM binaries
TuistCache/
Tuist/Dependencies/

# ========================
# App Config / Secrets
# ========================

# Environment configs
*.xcconfig
!*.example.xcconfig
# Example: Config/Release.xcconfig, Config/Debug.xcconfig

# Apphud / API Keys
*.plist
!Info.plist    # кроме основного Info.plist

# Secrets / Keys / Tokens
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p8
*.mobileprovision
GoogleService-Info.plist
Secrets.xcconfig
Secrets.local.xcconfig
*.local.xcconfig

# ========================
# iOS / System files
# ========================

.DS_Store
*.swp
*.lock
*.tmp
Thumbs.db

# iCloud sync metadata
*.icloud

# ========================
# Xcode Previews / Cache
# ========================

*.preview-thumbnails
*.xcpreviewassets

# ========================
# Project-specific (custom)
# ========================

# Logs and local caches
*.log
*.trace
Logs/

# Local user data (e.g. tokens, sandbox)
UserData/
Temp/
tmp/

# API Mock files (if used)
MockData/

# ========================
#  Git
# ========================

# Ignore git-merge backups
*.orig
*.rej
